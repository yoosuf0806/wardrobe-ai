# --- Supabase (leave blank to run in local DEMO mode with an in-memory wardrobe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude (garment tagging + stylist). Blank = deterministic engine only, manual tagging ---
ANTHROPIC_API_KEY=
# Optional overrides
STYLIST_MODEL=claude-opus-5-5
STYLIST_EFFORT=medium

# --- Weather (OpenWeatherMap). Blank = manual temperature entry ---
OPENWEATHER_API_KEY=

# --- Shopping / gap analysis ---
# daraz (default, free – no key) | amazon (needs SERPAPI_API_KEY, paid) | google_shopping
SHOPPING_PROVIDER=daraz
# daraz.lk (LKR) | daraz.pk (PKR) | daraz.com.bd (BDT) | daraz.com.np (NPR)
DARAZ_DOMAIN=daraz.lk
# Deep-link format from your Daraz affiliate dashboard, with {url} where the product URL goes
DARAZ_AFFILIATE_URL_TEMPLATE=
# Amazon (optional)
AMAZON_ASSOCIATE_TAG=
AMAZON_DOMAIN=amazon.com
SERPAPI_API_KEY=
SHOPPING_COUNTRY=us
# Optional FX overrides (units per 1 USD) used to compare budgets with store prices
# FX_RATES={"LKR":300}

# --- Optional media pipeline ---
# remove.bg key for background removal on save (blank = keep original photo)
REMOVE_BG_API_KEY=
# Fashion-CLIP embedding endpoint: POST {image: <base64>} -> {embedding: number[512]}
FASHION_CLIP_ENDPOINT=
FASHION_CLIP_TOKEN=

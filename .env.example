# --- Supabase (leave blank to run in local DEMO mode with an in-memory wardrobe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude (garment tagging + stylist). Blank = deterministic engine only, manual tagging ---
ANTHROPIC_API_KEY=
# Optional overrides
STYLIST_MODEL=claude-opus-5-5
STYLIST_EFFORT=medium

# --- Weather (OpenWeatherMap). Blank = manual temperature entry ---
OPENWEATHER_API_KEY=

# --- Shopping / gap analysis (Amazon). Blank SERPAPI key = mock catalogue ---
# Amazon Associates tracking ID, appended to every product/search link
AMAZON_ASSOCIATE_TAG=
AMAZON_DOMAIN=amazon.com
# SerpAPI key for live Amazon listings (https://serpapi.com/amazon-search-api)
SERPAPI_API_KEY=
# amazon (default) | google_shopping
SHOPPING_PROVIDER=amazon
SHOPPING_COUNTRY=us

# --- Optional media pipeline ---
# remove.bg key for background removal on save (blank = keep original photo)
REMOVE_BG_API_KEY=
# Fashion-CLIP embedding endpoint: POST {image: <base64>} -> {embedding: number[512]}
FASHION_CLIP_ENDPOINT=
FASHION_CLIP_TOKEN=
